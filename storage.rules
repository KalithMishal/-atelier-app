rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images: public read, no public writes.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // User profile photos: owner can write; read allowed for app image loading (URLs are unguessable).
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: block everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

